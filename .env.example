# ============================================
# LingoFlow - Environment Variables
# ============================================
# Copy this file to .env and fill in your free API keys.

# Deepgram API Key (Free $200 credit on signup)
# Get yours at: https://console.deepgram.com/signup
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Groq API Key (Free perpetual tier)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
